# TrustVault Backend — Environment Variables
# Copy this file to .env and fill in real values for production.
# Never commit .env to source control.

# ─── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production

# ─── Administrator Provisioning Secret ───────────────────────────────────────
# Required when registering an Administrator account via the API.
# The default value here is for development only; change before going live.
TRUSTVAULT_ADMIN_SECRET=TV-ADMIN-PROVISION-2026

# ─── SMS Gateway (Twilio) ────────────────────────────────────────────────────
# Leave unset to run in clearly-labelled Development Mode (OTP shown in response).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15005550006

# ─── Email Dispatch (Brevo / Gmail / Resend) ──────────────────────────────────
# Option 1: Brevo HTTPS API (RECOMMENDED for Render & Cloud deployments)
# Outbound SMTP ports (587, 465) are often blocked on cloud free tiers.
# Brevo REST API uses port 443 which is never blocked and delivers to any inbox.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=your-verified-brevo-email@gmail.com

# Option 2: Brevo SMTP Relay
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login-email@gmail.com
# EMAIL_HOST_PASSWORD=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=TrustVault Security <your-verified-brevo-email@gmail.com>

# Option 3: Gmail SMTP
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-account@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx (Google App Password)
# DEFAULT_FROM_EMAIL=TrustVault Security <your-account@gmail.com>
